{
  "multipart": [
    {
      "apply": [
        {
          "model": "netherdescent:block/sythian_stalk1_age0"
        },
        {
          "model": "netherdescent:block/sythian_stalk2_age0"
        },
        {
          "model": "netherdescent:block/sythian_stalk3_age0"
        },
        {
          "model": "netherdescent:block/sythian_stalk4_age0"
        }
      ],
      "when": {
        "age": "0"
      }
    },
    {
      "apply": [
        {
          "model": "netherdescent:block/sythian_stalk1_age1"
        },
        {
          "model": "netherdescent:block/sythian_stalk2_age1"
        },
        {
          "model": "netherdescent:block/sythian_stalk3_age1"
        },
        {
          "model": "netherdescent:block/sythian_stalk4_age1"
        }
      ],
      "when": {
        "age": "1"
      }
    },
    {
      "apply": {
        "model": "netherdescent:block/sythian_stalk_small_leaves"
      },
      "when": {
        "leaves": "small"
      }
    },
    {
      "apply": {
        "model": "netherdescent:block/sythian_stalk_large_leaves"
      },
      "when": {
        "leaves": "large"
      }
    }
  ]
}